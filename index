<script>
// DỮ LIỆU SẢN PHẨM
const products = [
  {
    id:1,name:"Miniature Food Collection",category:"diy",
    label:"DIY MINI KIT",price:299000,
    description:"Bộ mô hình đồ ăn thu nhỏ dành cho người yêu thích lắp ráp và sáng tạo.",
