NGÂN SÁCH: ${f.get("budget")}
Ý TƯỞNG: ${f.get("idea")}`;

  sendEmail("Yêu cầu thiết kế mô hình MINIVERSE",body);
  showToast("Đang mở ứng dụng email.");
});

document.getElementById("contactForm").addEventListener("submit",function(e){
  e.preventDefault();
  const f=new FormData(this);
  const body=`HỌ TÊN: ${f.get("name")}\nEMAIL: ${f.get("email")}\nNỘI DUNG: ${f.get("message")}`;
  sendEmail("Liên hệ MINIVERSE",body);
  showToast("Đang mở ứng dụng email.");
