${order}

TỔNG TIỀN: ${money(total)}

GHI CHÚ: ${f.get("note")}`;

  sendEmail("Đơn hàng MINIVERSE",body);
  showToast("Đang mở ứng dụng email để gửi yêu cầu.");
});

