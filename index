  },
  {
    id:2,name:"Miniature Character",category:"custom",
    label:"CÁ NHÂN HÓA",price:990000,
    description:"Mô hình nhân vật thu nhỏ được thiết kế theo ý tưởng và đặc điểm riêng.",
    image:"https://images.unsplash.com/photo-1558060370-d644479cb6f7?auto=format&fit=crop&w=800&q=85"
  },
  {
    id:3,name:"Premium Mini Collection",category:"premium",
    label:"PREMIUM",price:1590000,
    description:"Bộ sưu tập mô hình mini với độ hoàn thiện và mức độ chi tiết cao.",
    image:"https://images.unsplash.com/photo-1560961911-ba7ef651a56c?auto=format&fit=crop&w=800&q=85"
  },
  {
    id:4,name:"Mini Accessories Set",category:"accessory",
    label:"PHỤ KIỆN",price:129000,
    description:"Bộ phụ kiện thu nhỏ giúp hoàn thiện và trang trí mô hình.",
    image:"https://images.unsplash.com/photo-1599623560574-39d485900c95?auto=format&fit=crop&w=800&q=85"
  },
  {
    id:5,name:"Creative DIY Mini Set",category:"diy",
    label:"DIY MINI KIT",price:399000,
    description:"Bộ sản phẩm sáng tạo với nhiều chi tiết nhỏ để tự tay lắp ráp.",
    image:"https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=800&q=85"
  },
  {
    id:6,name:"Custom Miniature Model",category:"custom",
    label:"CÁ NHÂN HÓA",price:1190000,
    description:"Mô hình được phát triển theo yêu cầu, chủ đề và ngân sách của khách hàng.",
    image:"https://images.unsplash.com/photo-1581235720704-06d3acfcb36f?auto=format&fit=crop&w=800&q=85"
  }
];

let activeFilter = "all";
let cart = JSON.parse(localStorage.getItem("miniverseCart") || "[]");

function money(value){
  return value.toLocaleString("vi-VN") + "đ";
}

function saveCart(){
  localStorage.setItem("miniverseCart",JSON.stringify(cart));
}

function renderProducts(){
  const keyword=document.getElementById("searchInput").value.toLowerCase().trim();
  const list=products.filter(p=>{
    const matchCategory=activeFilter==="all" || p.category===activeFilter;
    const matchKeyword=p.name.toLowerCase().includes(keyword) ||
      p.description.toLowerCase().includes(keyword);
    return matchCategory && matchKeyword;
  });

  const grid=document.getElementById("productGrid");

  if(!list.length){
    grid.innerHTML='<div class="empty-state">Không tìm thấy sản phẩm phù hợp.</div>';
    return;
  }

  grid.innerHTML=list.map(p=>`
    <article class="product-card">
      <div class="product-image">
        <img src="${p.image}" alt="${p.name}" loading="lazy">
        <span class="product-tag">${p.label}</span>
      </div>
      <div class="product-info">
        <div class="product-category">${p.category==="diy"?"Bộ tự lắp ráp":p.category==="custom"?"Thiết kế riêng":p.category==="premium"?"Dòng cao cấp":"Phụ kiện mini"}</div>
        <h3>${p.name}</h3>
        <p>${p.description}</p>
        <div class="product-bottom">
          <span class="price">${money(p.price)}</span>
          <div class="product-actions">
            <button class="small-btn secondary" onclick="showDetail(${p.id})">Chi tiết</button>
            <button class="small-btn" onclick="addCart(${p.id})">Thêm giỏ</button>
          </div>
        </div>
      </div>
    </article>
  `).join("");
}

function setFilter(filter,button){
  activeFilter=filter;
  document.querySelectorAll(".filter-btn").forEach(b=>b.classList.remove("active"));
  button.classList.add("active");
  renderProducts();
}

function selectCategory(filter){
  activeFilter=filter;
  document.querySelectorAll(".filter-btn").forEach(b=>{
    b.classList.toggle("active",b.dataset.filter===filter);
  });
  document.getElementById("products").scrollIntoView({behavior:"smooth"});
  renderProducts();
}

function addCart(id){
  const p=products.find(x=>x.id===id);
  const item=cart.find(x=>x.id===id);
  if(item)item.quantity++;
  else cart.push({...p,quantity:1});
  updateCart();
  showToast("Đã thêm sản phẩm vào giỏ hàng.");
}

function updateCart(){
  saveCart();
  const count=cart.reduce((s,x)=>s+x.quantity,0);
  const total=cart.reduce((s,x)=>s+x.price*x.quantity,0);
  document.getElementById("cartCount").textContent=count;
  document.getElementById("cartTotal").textContent=money(total);

  const area=document.getElementById("cartItems");
  if(!cart.length){
    area.innerHTML='<p style="font-size:13px;color:#82766c">Giỏ hàng của bạn đang trống.</p>';
    return;
  }

  area.innerHTML=cart.map(x=>`
    <div class="cart-row">
      <div>
        <strong>${x.name}</strong>
        <div>${money(x.price)}</div>
        <div class="quantity">
          <button onclick="changeQuantity(${x.id},-1)">−</button>
          <span>${x.quantity}</span>
          <button onclick="changeQuantity(${x.id},1)">+</button>
        </div>
      </div>
      <button onclick="removeCart(${x.id})">Xóa</button>
    </div>
  `).join("");
}

function changeQuantity(id,amount){
  const item=cart.find(x=>x.id===id);
  if(!item)return;
  item.quantity+=amount;
  if(item.quantity<=0)removeCart(id);
  else updateCart();
}

function removeCart(id){
  cart=cart.filter(x=>x.id!==id);
  updateCart();
}

function openCart(){
  document.getElementById("cartDrawer").classList.add("open");
  document.getElementById("overlay").classList.add("show");
}
function closeCart(){
  document.getElementById("cartDrawer").classList.remove("open");
  document.getElementById("overlay").classList.remove("show");
}

function showDetail(id){
  const p=products.find(x=>x.id===id);
  document.getElementById("detailContent").innerHTML=`
    <img src="${p.image}" alt="${p.name}">
    <div class="eyebrow">${p.label}</div>
    <h2>${p.name}</h2>
    <p>${p.description}</p>
    <h3 style="color:#76543d;margin:15px 0">${money(p.price)}</h3>
    <button class="btn" onclick="addCart(${p.id});closeModal('detailModal')">Thêm vào giỏ hàng</button>
  `;
  openModal("detailModal");
}

function openModal(id){document.getElementById(id).classList.add("show")}
function closeModal(id){document.getElementById(id).classList.remove("show")}
function outsideClose(event,id){
  if(event.target.id===id)closeModal(id);
}

function openCheckout(){
  if(!cart.length){showToast("Giỏ hàng đang trống.");return;}
  closeCart();
  openModal("checkoutModal");
}

function openCustomForm(){openModal("customModal")}
function openContactForm(){openModal("contactModal")}

function sendEmail(subject,body){
  // THAY EMAIL BÊN DƯỚI BẰNG EMAIL CỦA MINIVERSE
  const email="your-email@example.com";
  window.location.href=`mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}

document.getElementById("checkoutForm").addEventListener("submit",function(e){
  e.preventDefault();
  const f=new FormData(this);
  const order=cart.map(x=>`${x.name} x ${x.quantity}: ${money(x.price*x.quantity)}`).join("\n");
